{
  "name": "videovault",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first personal video library (see SPEC.md and STATE.md)",
  "type": "module",
  "scripts": {
    "setup": "npm --prefix apps/desktop ci && npx --prefix apps/desktop playwright install chromium",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --skip e2e,web-build",
    "test:rust": "cargo test --workspace",
    "test:web": "npm --prefix apps/desktop run test",
    "e2e": "npm --prefix apps/desktop run e2e",
    "dev:fixture": "npm --prefix apps/desktop run dev:fixture",
    "desktop": "npm --prefix apps/desktop run desktop:dev",
    "desktop:build": "npm --prefix apps/desktop run desktop:build",
    "desktop:exe": "npm --prefix apps/desktop run desktop:exe",
    "e2e:desktop": "npm --prefix apps/desktop run e2e:desktop",
    "desktop:e2e-exe": "node scripts/build-e2e-exe.mjs",
    "fixtures:ytdlp": "node scripts/capture-ytdlp-fixtures.mjs",
    "fixtures:media": "node scripts/make-playback-media.mjs",
    "tools:fetch": "node scripts/fetch-tools.mjs",
    "coverage:write": "node scripts/coverage-matrix.mjs --write",
    "bench": "node scripts/bench.mjs",
    "asr:report": "node scripts/asr-report.mjs"
  }
}
