{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: only VideoVault's own commands, plus listening for the import event. No filesystem, dialog, shell or HTTP permissions (SPEC §10.1, §20; ADR-0013).",
  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-get-status",
    "allow-get-diagnostics",
    "allow-list-items",
    "allow-get-item",
    "allow-import-media",
    "allow-check-url",
    "allow-save-url",
    "allow-restore-item",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
