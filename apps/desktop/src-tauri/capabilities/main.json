{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: only VideoVault's own commands, plus listening for the import event. No filesystem, dialog, shell or HTTP permissions (SPEC §10.1, §20; ADR-0013).",
  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-get-status",
    "allow-get-diagnostics",
    "allow-list-items",
    "allow-get-item",
    "allow-import-media",
    "allow-check-url",
    "allow-save-url",
    "allow-restore-item",
    "allow-get-sidebar",
    "allow-undo",
    "allow-tag-items",
    "allow-untag-items",
    "allow-add-to-collection",
    "allow-remove-from-collection",
    "allow-set-favorite",
    "allow-set-archived",
    "allow-remove-items",
    "allow-restore-items",
    "allow-delete-items-permanently",
    "allow-rename-tag",
    "allow-merge-tags",
    "allow-delete-tag",
    "allow-create-collection",
    "allow-rename-collection",
    "allow-move-collection",
    "allow-delete-collection",
    "allow-save-smart-collection",
    "allow-delete-smart-collection",
    "allow-set-notes",
    "allow-list-duplicates",
    "allow-preview-merge",
    "allow-merge-items",
    "allow-dismiss-duplicate",
    "allow-list-orphans",
    "allow-reimport-orphan",
    "allow-delete-orphan",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
